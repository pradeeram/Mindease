# ==============================================================================
# MindEase Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# For Local Dev with SQLite: file:./dev.db
# For Production with Supabase/PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL="file:./dev.db"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:/postgres"

# JWT Secrets for Authentication
JWT_ACCESS_SECRET="mindease_super_secure_access_secret_key_change_in_production_32chars_min"
JWT_REFRESH_SECRET="mindease_super_secure_refresh_secret_key_change_in_production_32chars_min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# AES-256 Data-at-Rest Encryption Secret for Sensitive Notes & Messages
DATA_ENCRYPTION_KEY="mindease_encryption_key_32_bytes_len_secure"

# AI Service Configuration (USHA)
# Option 1: Google Gemini API (Recommended for Cloud deployment)
GEMINI_API_KEY="s"

# Option 2: Anthropic Claude API (Alternative)
ANTHROPIC_API_KEY=""

# Option 3: Local/Self-Hosted LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
