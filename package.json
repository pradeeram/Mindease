{
  "name": "mindease",
  "version": "1.0.0",
  "description": "MindEase - Evidence-Based Mental Health & CBT Platform with USHA AI Companion",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "cd frontend && npx tsc && npx vite build",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install --include=dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mental-health",
    "cbt",
    "ai-companion",
    "mood-tracker",
    "voice-chat",
    "mindease"
  ],
  "author": "MindEase Team",
  "license": "MIT"
}
