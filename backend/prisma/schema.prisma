generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String         @id @default(cuid())
  email                     String         @unique
  passwordHash              String
  name                      String
  role                      String         @default("USER")
  avatar                    String?
  mfaEnabled                Boolean        @default(false)
  mfaSecret                 String?
  googleId                  String?        @unique
  theme                     String         @default("light")
  baselineScore             Int?
  onboarded                 Boolean        @default(false)
  
  // Security & Account State Fields
  emailVerified             Boolean        @default(false)
  verificationTokenHash     String?
  verificationTokenExpires DateTime?
  resetPasswordTokenHash    String?
  resetPasswordExpires      DateTime?
  failedLoginAttempts       Int            @default(0)
  lockedUntil               DateTime?

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  moodEntries               MoodEntry[]
  journalEntries            JournalEntry[]
  chatSessions              ChatSession[]
  chatMessages              ChatMessage[]
  consents                  Consent[]
  auditLogs                 AuditLog[]
  reminders                 Reminder[]
  safetyPlan                SafetyPlan?

  @@index([email])
}

model MoodEntry {
  id                String    @id @default(cuid())
  userId            String
  score             Int       // 1 to 10
  primaryEmotion    String    // e.g., Joy, Anxiety, Calm, Overwhelmed, Sadness, Anger
  secondaryEmotions String    // JSON string array of tags
  intensity         Int       @default(50) // 1 - 100
  notesEncrypted    String?
  factors           String    // JSON string array e.g., ["Sleep", "Work", "Exercise"]
  sleepHours        Float?
  anxietyLevel      Int?      // 1 - 10
  energyLevel       Int?      // 1 - 10
  loggedAt          DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, primaryEmotion])
}

model JournalEntry {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  situation          String
  automaticThought   String
  distortionTags     String    // JSON string array e.g., ["Catastrophizing", "All-or-Nothing"]
  cognitiveReframing String
  moodBefore         Int       // 1 - 10
  moodAfter          Int       // 1 - 10
  outcomeNote        String?
  isFavorite         Boolean   @default(false)
  loggedAt           DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, isFavorite])
}

model ChatSession {
  id           String        @id @default(cuid())
  userId       String
  title        String        @default("New Reflection")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id                String      @id @default(cuid())
  sessionId         String
  userId            String
  role              String      // "user" | "usha" | "system"
  contentEncrypted  String
  isCrisisTriggered Boolean     @default(false)
  metadata          String?     // JSON metadata
  timestamp         DateTime    @default(now())

  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([userId, timestamp])
}

model Consent {
  id            String    @id @default(cuid())
  userId        String
  policyType    String    // "TERMS" | "PRIVACY" | "DATA_PROCESSING" | "CRISIS_DISCLAIMER"
  agreedVersion String
  ipAddress     String?
  userAgent     String?
  agreedAt      DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, policyType])
}

model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   String?
  status    String    @default("SUCCESS")
  timestamp DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([action])
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  type       String    // "MOOD_CHECKIN" | "BREATHING_BREAK" | "JOURNALING"
  title      String
  time       String    // "HH:mm" e.g., "09:00"
  daysOfWeek String    // JSON array e.g., ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]
  isEnabled  Boolean   @default(true)
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
}

model SafetyPlan {
  id                    String    @id @default(cuid())
  userId                String    @unique
  warningSigns          String    // JSON array
  copingStrategies      String    // JSON array
  distractionPlaces     String    // JSON array
  supportiveContacts    String    // JSON array
  professionalResources String    // JSON array
  safeEnvironmentSteps  String    // JSON array
  updatedAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
