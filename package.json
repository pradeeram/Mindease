{
  "name": "mindease",
  "version": "1.0.0",
  "description": "MindEase - Evidence-Based Mental Health & CBT Platform with USHA AI Companion",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "install:all": "npm install",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mental-health",
    "cbt",
    "ai-companion",
    "mood-tracker",
    "voice-chat",
    "mindease"
  ],
  "author": "MindEase Team",
  "license": "MIT"
}
